# GitHub API Authentication Token (Personal Access Token or Fine-Grained Token)
GITHUB_TOKEN=your_token_here

# GitHub Repository Owner (Organization or Username)
GITHUB_OWNER=your_org_or_username

# GitHub Repository Name
GITHUB_REPO=your_repo_name

# Default Base Branch for PRs
BASE_BRANCH=main

# Execution Mode: 'local' for simulation or 'github' for live API operations
MODE=local
